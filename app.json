{
  "expo": {
    "name": "flui",
    "slug": "flui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flui-bolt.png",
    "scheme": "flui",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/flui-bolt.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000",
      "dark": {
        "image": "./assets/images/flui-bolt.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/flui-bolt.png",
        "monochromeImage": "./assets/images/flui-bolt.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/flui-bolt.png",
      "name": "FLUI",
      "shortName": "FLUI",
      "description": "Encontre os melhores pontos de recarga para carros elétricos e híbridos.",
      "backgroundColor": "#000000",
      "themeColor": "#B748FB",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Flui utilize sua localização para encontrar estações próximas."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69fffebb-7ad3-454e-8dc8-188ae07bb190"
      }
    }
  }
}
